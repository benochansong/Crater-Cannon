{
  "name": "crater-cannon",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts docs README.md",
    "test:balance": "tsx scripts/balance-phase8.ts",
    "test:balance:phase3": "tsx scripts/balance.ts",
    "test:balance:phase4": "tsx scripts/balance-phase4.ts",
    "test:balance:phase5": "tsx scripts/balance-phase5.ts",
    "test:balance:phase6": "tsx scripts/balance-phase6.ts",
    "test:balance:phase7": "tsx scripts/balance-phase7.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
